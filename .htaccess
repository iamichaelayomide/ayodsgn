RewriteEngine On
Options -Indexes
# OAuth discovery for account-scoped planner assistants.
RewriteCond %{HTTP_HOST} ^life\.ayodsgn\.com$ [NC]
RewriteRule ^\.well-known/oauth-protected-resource$ api/planner/discovery.php?type=resource [L]
RewriteCond %{HTTP_HOST} ^life\.ayodsgn\.com$ [NC]
RewriteRule ^\.well-known/oauth-authorization-server$ api/planner/discovery.php?type=server [L]
RewriteCond %{HTTP:Authorization} ^(.*)$
RewriteRule ^api/planner/ - [E=HTTP_AUTHORIZATION:%1]
# Tab shares only the locally vendored editor assets with Life.
# The personal workspace and its API stay blocked on the Tab host.
RewriteCond %{HTTP_HOST} ^tab\.ayodsgn\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/life/vendor/quill/quill\.(?:js|core\.css)$
RewriteRule ^(?:life|api/life)(?:/|$) - [F,L]
RewriteCond %{HTTP_HOST} ^tab\.ayodsgn\.com$ [NC]
RewriteRule ^$ tab/index.php [L]

# Development fixtures, maintenance commands and deployment metadata are never public routes.
RewriteRule ^(?:tests|scripts|docs)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule \.(?:sql|sqlite|sqlite3|bak|log|pem|key)$ - [F,L,NC]
RewriteRule ^\.git(?:/|$) - [F,L]
# One canonical planner origin. Keep old bookmarks and invitations working.
RewriteCond %{HTTP_HOST} ^(?:www\.)?ayodsgn\.com$ [NC]
RewriteRule ^life(?:/index\.php)?/?$ https://life.ayodsgn.com/ [R=308,L,NE]
RewriteCond %{HTTP_HOST} ^(?:www\.)?ayodsgn\.com$ [NC]
RewriteRule ^api/life/(.*)$ https://life.ayodsgn.com/api/life/$1 [R=308,L,NE]
RewriteCond %{HTTP_HOST} ^life\.ayodsgn\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+life/(?:index\.php)?(?:[?\s]) [NC]
RewriteRule ^life/(?:index\.php)?$ / [R=308,L]
RewriteCond %{HTTP_HOST} ^life\.ayodsgn\.com$ [NC]
RewriteRule ^$ life/index.php [L]
