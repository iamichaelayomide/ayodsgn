{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ayodsgn.vercel.app"
        }
      ],
      "destination": "https://ayodsgn.com/:path*",
      "permanent": true
    }
  ]
}
