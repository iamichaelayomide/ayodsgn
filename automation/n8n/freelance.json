{
  "name": "Ayo background research — freelance",
  "active": false,
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "worker-settings",
      "name": "Worker settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const job=$input.first().json;const usePrivateContext=false;const autoWriteEnabled=false; // Enable each only after the matching owner approval.\nif(job.pipeline!==\"freelance\")throw new Error('Wrong research agent');\nreturn [{json:{...job,usePrivateContext:usePrivateContext||job.usePrivateContext===true,autoWriteEnabled}}];"
      }
    },
    {
      "id": "research-through-life-gemini",
      "name": "Research through Life Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://life.ayodsgn.com/api/life/?action=opportunity-agents.execute",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({jobId:$json.id,leaseToken:$json.leaseToken,usePrivateContext:$json.usePrivateContext}) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "approved-tracking-writes",
      "name": "Approved tracking writes",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "approved-condition",
              "leftValue": "={{ $json.status === \"completed\" && $(\"Worker settings\").first().json.autoWriteEnabled === true && $(\"Worker settings\").first().json.autoApply === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "apply-sourced-tracking-records",
      "name": "Apply sourced tracking records",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "https://life.ayodsgn.com/api/life/?action=opportunity-agents.apply",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({jobId:$json.jobId}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Worker settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Worker settings": {
      "main": [
        [
          {
            "node": "Research through Life Gemini",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Research through Life Gemini": {
      "main": [
        [
          {
            "node": "Approved tracking writes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved tracking writes": {
      "main": [
        [
          {
            "node": "Apply sourced tracking records",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "timezone": "Africa/Lagos",
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  }
}
