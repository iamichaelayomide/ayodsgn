{
  "name": "Ayo scoped research coordinator — connect credentials first",
  "active": false,
  "nodes": [
    {
      "id": "manual-test",
      "name": "Manual test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "poll-each-minute",
      "name": "Poll each minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        180
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "* * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "connection-gate",
      "name": "Connection gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const enabled=false;\nconst workflowIds={nysc:'',freelance:'',career:'',ai_testing:''};\nif(!enabled||Object.values(workflowIds).some(id=>!id))throw new Error('Import four child workflows, configure their model/credentials, select their IDs, then enable this coordinator');\nreturn [{json:{workflowIds}}];"
      }
    },
    {
      "id": "claim-public-research-jobs",
      "name": "Claim public research jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://life.ayodsgn.com/api/life/?action=opportunity-agents.poll",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"limit\":4}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "select-nysc",
      "name": "Select nysc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        0
      ],
      "parameters": {
        "jsCode": "return ($input.first().json.jobs||[]).filter(j=>j.pipeline===\"nysc\").map(j=>({json:j}));"
      }
    },
    {
      "id": "launch-nysc",
      "name": "Launch nysc",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "={{ $('Connection gate').first().json.workflowIds.nysc }}",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      }
    },
    {
      "id": "select-freelance",
      "name": "Select freelance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        200
      ],
      "parameters": {
        "jsCode": "return ($input.first().json.jobs||[]).filter(j=>j.pipeline===\"freelance\").map(j=>({json:j}));"
      }
    },
    {
