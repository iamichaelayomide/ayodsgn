{
  "name": "Ayo background research coordinator — approval required",
  "active": false,
  "nodes": [
    {
      "id": "manual-check",
      "name": "Manual check",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "daily-9-am-lagos",
      "name": "Daily 9 AM Lagos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        180
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "check-queued-jobs-each-minute",
      "name": "Check queued jobs each minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        360
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "1-59 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "manual-mode",
      "name": "Manual mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{queueDaily:false}}];"
      }
    },
    {
      "id": "daily-mode",
      "name": "Daily mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        180
      ],
      "parameters": {
        "jsCode": "return [{json:{queueDaily:true}}];"
      }
    },
    {
      "id": "polling-mode",
      "name": "Polling mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        360
      ],
      "parameters": {
        "jsCode": "const hour=Number(new Intl.DateTimeFormat('en-GB',{hour:'2-digit',hourCycle:'h23',timeZone:'Africa/Lagos'}).format(new Date()));return [{json:{queueDaily:hour>=9}}];"
      }
    },
    {
      "id": "connection-gate",
      "name": "Connection gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        140
      ],
      "parameters": {
        "jsCode": "const enabled=false;const workflowIds={nysc:'',freelance:'',career:'',ai_testing:''};\nif(!enabled||Object.values(workflowIds).some(id=>!id))throw new Error('Select Life research & tracking credential and four child workflow IDs after owner approval, then enable');\nreturn [{json:{...$input.first().json,workflowIds}}];"
      }
    },
    {
      "id": "queue-today-s-batch",
      "name": "Queue today’s batch",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        140
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "approved-condition",
              "leftValue": "={{ $json.queueDaily === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "queue-bounded-daily-prospects",
      "name": "Queue bounded daily prospects",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://life.ayodsgn.com/api/life/?action=opportunity-agents.daily",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "claim-research-jobs",
      "name": "Claim research jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        140
      ],
      "parameters": {
        "method": "POST",
        "url": "https://life.ayodsgn.com/api/life/?action=opportunity-agents.poll",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"limit\":4}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "select-nysc",
      "name": "Select nysc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        0
      ],
      "parameters": {
        "jsCode": "return ($input.first().json.jobs||[]).filter(j=>j.pipeline===\"nysc\").map(j=>({json:j}));"
      }
    },
    {
      "id": "launch-nysc",
      "name": "Launch nysc",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1580,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "={{ $(\"Connection gate\").first().json.workflowIds.nysc }}",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      }
    },
